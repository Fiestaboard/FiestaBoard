{
  "scenario": "welcome_local",
  "description": "Setup-wizard welcome: a fresh client from the primary board, forced, with the transition settings.",
  "seam": "POST /send-welcome-message",
  "steps": [
    {
      "action": "send the welcome message",
      "requests": [
        {
          "method": "POST",
          "url": "http://192.168.0.10:7000/local-api/message",
