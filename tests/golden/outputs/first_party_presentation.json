          }
        },
        "result_fields": {},
        "visible_when": {
          "api_mode": "local",
          "@device_type": "note_array"
        },
        "auto_apply": false
      },
      {
        "id": "identify",
        "label": "Identify",
        "description": "Flash each note-array tile's position on it.",
        "builtin": true,
        "input_schema": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "enum": [
                "tile",
                "all"
              ],
              "default": "tile"
            },
            "row": {
              "type": "integer",
              "minimum": 0
            },
            "col": {
              "type": "integer",
              "minimum": 0
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "local_api_key": {
              "type": "string",
              "secret": true
            }
          }
        },
        "result_fields": {},
        "visible_when": {
          "api_mode": "local",
          "@device_type": "note_array"
        },
        "auto_apply": false
      },
      {
        "id": "detect_geometry",
        "label": "Auto-detect from board",
        "description": "Read the board's current layout and set its type and size to match.",
        "builtin": true,
        "input_schema": null,
        "result_fields": {},
        "visible_when": {
          "not": {
            "api_mode": "local",
            "@device_type": "note_array"
          }
        },
        "auto_apply": true
      },
      {
        "id": "enable_local_api",
        "label": "Get API Key from Board",
        "description": "Exchange a Local API enablement token (from vestaboard.com/local-api) for a Local API key.",
        "builtin": false,
        "input_schema": {
          "type": "object",
          "properties": {
            "enablement_token": {
              "type": "string",
              "title": "Enablement Token",
              "ui:placeholder": "Token from vestaboard.com/local-api",
              "secret": true,
              "minLength": 1
            },
            "host": {
              "type": "string",
              "title": "Board IP Address",
              "ui:placeholder": "192.168.1.100"
            }
          },
          "required": [
            "enablement_token"
          ]
        },
        "result_fields": {
          "api_key": {
            "secret": true,
            "fills": "local_api_key"
          }
        },
        "visible_when": {
          "api_mode": "local"
        },
        "auto_apply": false
      }
    ],
