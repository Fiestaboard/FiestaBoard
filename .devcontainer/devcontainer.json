{
  "name": "FiestaBoard",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" }
  },
  "postCreateCommand": "cp env.example .env && echo 'Run: docker-compose -f docker-compose.dev.yml up --build'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.docker"
      ]
    }
  },
  "forwardPorts": [4420],
  "portsAttributes": {
    "4420": {
      "label": "FiestaBoard (Web UI + API)",
      "onAutoForward": "notify"
    }
  }
}

