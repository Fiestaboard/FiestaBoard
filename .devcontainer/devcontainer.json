{
  "name": "FiestaBoard",
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },

  // Mount workspace at /app so existing configs (supervisord, nginx) work as-is
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind,consistency=cached",
  "workspaceFolder": "/app",

  // Lifecycle commands
  "postCreateCommand": ".devcontainer/post-create.sh",
  "postStartCommand": "mkdir -p data/logs && supervisord -c supervisord-dev.conf",

  // Port forwarding
  "forwardPorts": [3000, 8000, 3001],
  "portsAttributes": {
    "3000": { "label": "FiestaBoard App", "onAutoForward": "notify" },
    "8000": { "label": "API Server", "onAutoForward": "silent" },
    "3001": { "label": "Next.js Dev", "onAutoForward": "silent" }
  },

  // VS Code / Codespaces customizations
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true
        }
      }
    }
  }
}

