{
  "name": "fiestaboard",
  "version": "2.1.2",
  "description": "Open-source server that turns your split-flap display into a living dashboard with weather, stocks, sports, transit, and more",
  "keywords": [
    "split-flap",
    "vestaboard",
    "dashboard",
    "home-automation",
    "display",
    "weather",
    "stocks",
    "sports",
    "docker",
    "raspberry-pi",
    "smart-display",
    "iot"
  ],
  "homepage": "https://fiestaboard.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fiestaboard/FiestaBoard.git"
  },
  "bugs": {
    "url": "https://github.com/Fiestaboard/FiestaBoard/issues"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "uvicorn src.api_server:app --reload --host 0.0.0.0 --port 8000",
    "dev:web": "cd web && npm run dev",
    "dev:docker": "docker-compose -f docker-compose.dev.yml up",
    "dev:docker:build": "docker-compose -f docker-compose.dev.yml up --build",
    "build:web": "cd web && npm run build",
    "start:web": "cd web && npm run start",
    "test:web": "cd web && npm run test:run",
    "lint:web": "cd web && npm run lint"
  }
}
