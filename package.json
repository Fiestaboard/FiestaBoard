{
  "name": "fiestaboard",
  "version": "2.1.69",
  "description": "Open-source server that turns your split-flap display into a living dashboard with weather, stocks, sports, transit, and more",
  "keywords": [
    "split-flap",
    "vestaboard",
    "dashboard",
    "home-automation",
    "display",
    "weather",
    "stocks",
    "sports",
    "docker",
    "raspberry-pi",
    "smart-display",
    "iot"
  ],
  "homepage": "https://fiestaboard.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fiestaboard/FiestaBoard.git"
  },
  "bugs": {
    "url": "https://github.com/Fiestaboard/FiestaBoard/issues"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "docker-compose -f docker-compose.dev.yml up",
    "dev:build": "docker-compose -f docker-compose.dev.yml up --build",
    "dev:mobile": "pnpm --filter mobile start",
    "build:web": "pnpm --filter web build",
    "start:web": "pnpm --filter web start",
    "test": "pnpm -r test",
    "test:web": "pnpm --filter web test:run",
    "test:mobile": "pnpm --filter mobile test",
    "test:shared": "pnpm --filter @fiestaboard/shared test",
    "lint:web": "pnpm --filter web lint",
    "typecheck": "pnpm -r typecheck"
  }
}
