{
  "id": "generic_data",
  "name": "Generic Data",
  "version": "1.2.0",
  "description": "Fetch data from any URL (JSON or XML) and map fields to template variables — supports multiple feeds",
  "author": "FiestaBoard Team",
  "repository": "https://github.com/FiestaBoard/FiestaBoard",
  "documentation": "README.md",
  "icon": "database",
  "category": "data",
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enable Generic Data",
        "default": false
      },
      "url": {
        "type": "string",
        "title": "Data URL",
        "description": "URL to fetch data from (for single-feed mode)"
      },
      "format": {
        "type": "string",
        "title": "Response Format",
        "description": "Format of the response data",
        "enum": [
          "json",
          "xml"
        ],
        "default": "json"
      },
      "method": {
        "type": "string",
        "title": "HTTP Method",
        "enum": [
          "GET",
          "POST"
        ],
        "default": "GET"
      },
      "headers": {
        "type": "array",
        "title": "Custom Headers",
        "description": "Optional HTTP headers (e.g., for authentication)",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "title": "Header Name"
            },
            "value": {
              "type": "string",
              "title": "Header Value"
            }
          },
          "required": [
            "name",
            "value"
          ]
        },
        "default": []
      },
      "body": {
        "type": "string",
        "title": "Request Body",
        "description": "Optional request body for POST requests"
      },
      "mappings": {
        "type": "array",
        "title": "Variable Mappings",
        "description": "Map response fields to template variables (for single-feed mode)",
        "ui:widget": "generic-data-mapping-helper",
        "items": {
          "type": "object",
          "properties": {
            "variable": {
              "type": "string",
              "title": "Variable Name",
              "description": "Name to use in templates (e.g., 'temperature')"
            },
            "path": {
              "type": "string",
              "title": "Data Path",
              "description": "Dot-notation path to the value (e.g., 'current.temp_f')"
            },
            "default": {
              "type": "string",
              "title": "Default Value",
              "description": "Value to use if the path is not found",
              "default": ""
            }
          },
          "required": [
            "variable",
            "path"
          ]
        },
        "default": []
      },
      "feeds": {
        "type": "array",
        "title": "Data Feeds",
        "description": "Multiple data sources — each with its own URL, format, and mappings. When set, the top-level URL/mappings are ignored.",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "title": "Feed Name",
              "description": "Label for this feed (e.g., 'Weather API')"
            },
            "url": {
              "type": "string",
              "title": "Data URL"
            },
            "format": {
              "type": "string",
              "title": "Response Format",
              "enum": [
                "json",
                "xml"
              ],
              "default": "json"
            },
            "method": {
              "type": "string",
              "title": "HTTP Method",
              "enum": [
                "GET",
                "POST"
              ],
              "default": "GET"
            },
            "headers": {
              "type": "array",
              "title": "Custom Headers",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "title": "Header Name"
                  },
                  "value": {
                    "type": "string",
                    "title": "Header Value"
                  }
                },
                "required": [
                  "name",
                  "value"
                ]
              },
              "default": []
            },
            "body": {
              "type": "string",
              "title": "Request Body"
            },
            "mappings": {
              "type": "array",
              "title": "Variable Mappings",
              "items": {
                "type": "object",
                "properties": {
                  "variable": {
                    "type": "string",
                    "title": "Variable Name"
                  },
                  "path": {
                    "type": "string",
                    "title": "Data Path"
                  },
                  "default": {
                    "type": "string",
                    "title": "Default Value",
                    "default": ""
                  }
                },
                "required": [
                  "variable",
                  "path"
                ]
              }
            }
          },
          "required": [
            "url",
            "mappings"
          ]
        }
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "How often to fetch new data",
        "default": 300,
        "minimum": 30
      }
    }
  },
  "env_vars": [
    {
      "name": "GENERIC_DATA_URL",
      "required": false,
      "description": "Data URL for single-feed mode (can also be set in UI)"
    }
  ],
  "variables": {
    "groups": {
      "main": {
        "label": "Main"
      }
    },
    "simple": {
      "feed_count": {
        "description": "Number of configured data feeds",
        "type": "number",
        "max_length": 2,
        "group": "main",
        "example": "3"
      }
    },
    "dynamic": true
  },
  "fiestaboard_version": ">=4.2.0",
  "screenshots": [
    {
      "src": "docs/board-display.png",
      "alt": "Generic Data displayed on a Vestaboard",
      "caption": "Fetch data from any URL (JSON or XML) and map fields to template variables — supports multiple feeds",
      "primary": true
    }
  ]
}
