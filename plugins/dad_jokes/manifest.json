{
  "id": "dad_jokes",
  "name": "Dad Jokes",
  "version": "1.0.0",
  "description": "Display random dad jokes from the icanhazdadjoke API",
  "author": "FiestaBoard Team",
  "repository": "https://github.com/FiestaBoard/FiestaBoard",
  "documentation": "README.md",
  "icon": "laugh",
  "category": "entertainment",

  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enable Dad Jokes",
        "default": false
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "How often to fetch a new dad joke",
        "default": 300,
        "minimum": 30,
        "maximum": 3600
      }
    }
  },

  "env_vars": [
    {
      "name": "DAD_JOKES_ENABLED",
      "required": false,
      "description": "Enable dad jokes feature",
      "default": "false"
    },
    {
      "name": "DAD_JOKES_REFRESH_SECONDS",
      "required": false,
      "description": "Refresh interval in seconds",
      "default": "300"
    }
  ],

  "variables": {
    "simple": [
      "joke"
    ]
  },

  "max_lengths": {
    "joke": 120
  }
}
