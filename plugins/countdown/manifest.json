{
  "id": "countdown",
  "name": "Countdown",
  "version": "1.1.1",
  "description": "Display the remaining time to an event in real time",
  "author": "FiestaBoard Team",
  "repository": "https://github.com/FiestaBoard/FiestaBoard",
  "documentation": "README.md",
  "icon": "timer",
  "category": "utility",
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enable Countdown",
        "default": false
      },
      "event_name": {
        "type": "string",
        "title": "Event Name",
        "description": "Name of the event to count down to (e.g., 'Last Day of School')",
        "default": "Event"
      },
      "target_datetime": {
        "type": "string",
        "title": "Target Date & Time",
        "description": "Target date and time in ISO format (e.g., 2025-06-15T00:00:00)",
        "ui:widget": "datetime"
      },
      "timezone": {
        "type": "string",
        "title": "Timezone",
        "description": "IANA timezone name (e.g., America/Los_Angeles)",
        "default": "America/Los_Angeles",
        "ui:widget": "timezone"
      }
    },
    "required": [
      "target_datetime"
    ]
  },
  "env_vars": [
    {
      "name": "COUNTDOWN_TARGET",
      "required": false,
      "description": "Target datetime in ISO format (can also be set in UI)"
    },
    {
      "name": "COUNTDOWN_EVENT_NAME",
      "required": false,
      "description": "Name of the event (can also be set in UI)"
    },
    {
      "name": "TIMEZONE",
      "required": false,
      "description": "IANA timezone (e.g., America/Los_Angeles)",
      "default": "America/Los_Angeles"
    }
  ],
  "variables": {
    "groups": {
      "event": {
        "label": "Event Info"
      },
      "countdown": {
        "label": "Countdown Values"
      }
    },
    "simple": {
      "event_name": {
        "description": "Name of the countdown event",
        "group": "event",
        "max_length": 22,
        "example": "Last Day of School"
      },
      "target_datetime": {
        "description": "Target date and time (ISO format)",
        "group": "event",
        "max_length": 19,
        "example": "2025-06-15T00:00:00"
      },
      "is_expired": {
        "description": "Whether the countdown has reached zero",
        "type": "boolean",
        "group": "event",
        "max_length": 5,
        "example": "false"
      },
      "days": {
        "description": "Days remaining",
        "type": "number",
        "group": "countdown",
        "max_length": 5,
        "example": "86"
      },
      "hours": {
        "description": "Hours remaining (0-23)",
        "type": "number",
        "group": "countdown",
        "max_length": 2,
        "example": "14"
      },
      "minutes": {
        "description": "Minutes remaining (0-59)",
        "type": "number",
        "group": "countdown",
        "max_length": 2,
        "example": "30"
      },
      "seconds": {
        "description": "Seconds remaining (0-59)",
        "type": "number",
        "group": "countdown",
        "max_length": 2,
        "example": "45"
      },
      "total_seconds": {
        "description": "Total seconds until target",
        "type": "number",
        "group": "countdown",
        "max_length": 10,
        "example": "7473045"
      },
      "formatted": {
        "description": "Pre-formatted countdown display",
        "group": "countdown",
        "max_length": 22,
        "example": "86d 14h 30m 45s"
      }
    }
  },
  "demo": {
    "name": "Countdown Demo",
    "device_type": "flagship",
    "template": [
      "",
      "{{countdown.event_name}}",
      "{{countdown.days}} days",
      "{{countdown.hours}}h {{countdown.minutes}}m",
      "{{countdown.formatted}}",
      ""
    ],
    "line_metadata": [
      {
        "alignment": "center",
        "wrap": false
      },
      {
        "alignment": "center",
        "wrap": false
      },
      {
        "alignment": "center",
        "wrap": false
      },
      {
        "alignment": "center",
        "wrap": false
      },
      {
        "alignment": "center",
        "wrap": false
      },
      {
        "alignment": "center",
        "wrap": false
      }
    ]
  },
  "screenshots": [
    {
      "src": "docs/board-display.png",
      "alt": "Countdown displayed on a Vestaboard",
      "caption": "Classic countdown template showing days remaining until an event",
      "primary": true
    }
  ]
}
