{
  "id": "spacecraft_launches",
  "name": "Spacecraft Launches",
  "version": "1.0.0",
  "description": "Track upcoming spacecraft launch countdowns and statuses",
  "author": "FiestaBoard Team",
  "repository": "https://github.com/FiestaBoard/FiestaBoard",
  "documentation": "README.md",
  "icon": "rocket",
  "category": "data",

  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enable Spacecraft Launches",
        "default": false
      },
      "max_launches": {
        "type": "integer",
        "title": "Max Launches",
        "description": "Maximum number of upcoming launches to display (1-10)",
        "default": 4,
        "minimum": 1,
        "maximum": 10
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "How often to fetch new data (minimum 240 seconds to respect 15 req/hr rate limit)",
        "default": 300,
        "minimum": 240
      }
    },
    "required": []
  },

  "env_vars": [
    {
      "name": "SPACECRAFT_LAUNCHES_ENABLED",
      "required": false,
      "description": "Enable spacecraft launches feature",
      "default": "false"
    },
    {
      "name": "SPACECRAFT_LAUNCHES_MAX_COUNT",
      "required": false,
      "description": "Maximum launches to display (default: 4)",
      "default": "4"
    },
    {
      "name": "SPACECRAFT_LAUNCHES_REFRESH_SECONDS",
      "required": false,
      "description": "Refresh interval in seconds (default: 300)",
      "default": "300"
    }
  ],

  "variables": {
    "simple": [
      "name",
      "status",
      "net",
      "countdown",
      "pad",
      "provider",
      "rocket",
      "mission",
      "formatted",
      "headers",
      "launch_count",
      "last_updated"
    ],
    "arrays": {
      "launches": {
        "label_field": "name",
        "item_fields": [
          "name",
          "status",
          "status_abbrev",
          "net",
          "net_date",
          "net_time",
          "countdown",
          "pad",
          "pad_location",
          "provider",
          "rocket",
          "mission",
          "formatted"
        ]
      }
    }
  },

  "max_lengths": {
    "name": 22,
    "status": 15,
    "net": 20,
    "countdown": 12,
    "pad": 20,
    "provider": 15,
    "rocket": 15,
    "mission": 22,
    "formatted": 22,
    "headers": 22,
    "launch_count": 2,
    "last_updated": 25,
    "launches.*.name": 22,
    "launches.*.status": 15,
    "launches.*.status_abbrev": 7,
    "launches.*.net": 20,
    "launches.*.net_date": 10,
    "launches.*.net_time": 5,
    "launches.*.countdown": 12,
    "launches.*.pad": 20,
    "launches.*.pad_location": 22,
    "launches.*.provider": 15,
    "launches.*.rocket": 15,
    "launches.*.mission": 22,
    "launches.*.formatted": 22
  },

  "color_rules_schema": {
    "status": {
      "type": "threshold",
      "description": "Color based on launch status"
    }
  }
}
