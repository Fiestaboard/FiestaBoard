{
  "name": "web",
  "version": "10.1.19",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1 --port 3001",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "node suppress-warnings.mjs vitest",
    "test:run": "node suppress-warnings.mjs vitest run",
    "test:coverage": "node suppress-warnings.mjs vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "test-storybook:ci": "test-storybook --ci",
    "analyze": "ANALYZE=true react-router build",
    "test:layout": "playwright test --config tests/layout/playwright.config.ts",
    "test:integration": "npx playwright test",
    "test:storybook-hosts": "node --test scripts/test-storybook-hosts.mjs"
  },
