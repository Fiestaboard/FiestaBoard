# @fiestaboard packages (the FiestaUI design system) are hosted on the
# GitHub Packages npm registry, which requires authentication even for
# public packages. This file only maps the scope to the registry — the
# auth token is NEVER committed. Provide it via your user-level
# ~/.npmrc (`//npm.pkg.github.com/:_authToken=<PAT with read:packages>`)
# or, in CI/Docker, via NODE_AUTH_TOKEN / the npm_token build secret.
@fiestaboard:registry=https://npm.pkg.github.com
