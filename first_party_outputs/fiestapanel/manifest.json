{
  "id": "fiestapanel",
  "name": "FiestaPanel",
  "version": "1.0.0",
  "description": "Any TV or browser: a full-screen board FiestaBoard draws itself.",
  "author": "FiestaBoard",
  "icon": "monitor",
  "category": "output",
  "plugin_type": "output",
  "screenshots": [
    {
      "src": "docs/board-display.png",
      "alt": "A FiestaPanel on a TV showing a colour bar, FIESTAPANEL and a train arrival line",
      "caption": "A FiestaPanel board in its split-flap look",
      "primary": true
    }
  ],
  "data_files": [
    "output/device-models.json"
  ],
  "output": {
    "output_api": 1,
    "device_models": {
      "$ref": "output/device-models.json"
    },
    "delivery": "pull",
    "min_interval_ms": 0,
    "read_back": {
      "supported": true,
      "cost": "cheap",
      "suggested_interval_s": 30
    },
    "native_transitions": [],
    "settings_schema": {
      "type": "object",
      "properties": {}
    },
    "actions": [
      {
        "id": "test_connection",
        "label": "Test connection"
      }
    ]
  }
}
