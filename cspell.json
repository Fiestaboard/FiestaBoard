{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "dictionaries": ["en_US", "node", "typescript", "npm", "softwareTerms", "html", "css", "bash", "fonts", "filetypes"],
  "files": [
    "docs/**/*.md",
    "docs-site/docs/**/*.md",
    "docs-site/docs/**/*.mdx",
    "plugins/*/README.md",
    "plugins/*/docs/**/*.md",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "DOCKERHUB_README.md"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "docs-site/build/**",
    "docs-site/.docusaurus/**",
    "docs-site/versioned_docs/**",
    "docs/superpowers/**",
    "CLAUDE.md",
    ".claude/**"
  ],
  "ignoreRegExpList": [
    "https?://\\S+",
    "```[\\s\\S]*?```",
    "`[^`]*`",
    "<!--[\\s\\S]*?-->",
    "\\{#[a-z0-9-]+\\}",
    "\\w*&[a-z]+;\\w*"
  ],
  "words": [
    "automations",
    "balena",
    "baywheels",
    "behaviour",
    "byok",
    "cerebras",
    "ciphertext",
    "conftest",
    "customisation",
    "dataclass",
    "dedup",
    "distros",
    "fiestaboard",
    "fiestapi",
    "fiestaupdater",
    "finnhub",
    "groq",
    "hacs",
    "haos",
    "headlessly",
    "healthcheck",
    "healthchecks",
    "heatsink",
    "icanhazdadjoke",
    "imager",
    "laggy",
    "localisation",
    "meteo",
    "mosquitto",
    "muni",
    "neutralise",
    "nifc",
    "noaa",
    "ollama",
    "organise",
    "pylint",
    "pytest",
    "retags",
    "rfkill",
    "rounddown",
    "scrobbling",
    "stardate",
    "streamflow",
    "tasmota",
    "uncooled",
    "unraid",
    "urlsafe",
    "usgs",
    "uvicorn",
    "vestaboard",
    "wcag",
    "weatherapi",
    "wlan",
    "wsdot",
    "zigbee"
  ]
}
